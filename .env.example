# ============================================
# RobotSIA Observa v2.0 — Variables de Entorno
# ============================================
# Copie este archivo como .env y complete los valores reales.
# NUNCA suba .env ni credentials/ a un repositorio.
# ============================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
APP_SECRET=cambiar-por-clave-secreta-larga-y-segura-aqui

# --- Modo de Operación ---
# true  = Simula SECOP, SIA y correo sin conexión real (pruebas locales)
# false = Conexión real a SECOP, SIA y correo (producción)
SIMULATION_MODE=true

# --- Redis (BullMQ) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=SiaRedis2026!

# --- Base de datos ---
DB_PATH=./storage/auditoria.db

# --- JWT Auth ---
JWT_SECRET=cambiar-por-otra-clave-secreta-diferente
JWT_EXPIRES_IN=8h

# ============================================
# CORREO — Configurar SOLO UNA de estas opciones
# ============================================

# OPCIÓN A: Mailpit (servidor local de pruebas) — DEFAULT EN DEV
# Correos visibles en http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# OPCIÓN B: Gmail personal con App Password (pruebas reales)
# 1. Activa 2FA en tu cuenta: myaccount.google.com/security
# 2. Ve a "Contraseñas de aplicación" y genera una para "Correo"
# 3. Descomenta y llena las variables:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx   # App Password (16 chars con espacios)

# OPCIÓN C: Google Workspace Institucional (producción final)
# Requiere Service Account con domain-wide delegation
# SMTP_HOST=smtp.gmail.com
# GMAIL_USER=sia.educacion@cauca.gov.co
# GOOGLE_SERVICE_ACCOUNT_KEY=./credentials/service-account.json

# --- Correo del remitente y destinatarios ---
GMAIL_USER=tucorreo@gmail.com
CORREO_FIRMA=siadepartamento@cauca.gov.co
CORREO_SUPERVISOR=supervisor@cauca.gov.co

# --- Google Workspace Domain ---
GOOGLE_WORKSPACE_DOMAIN=cauca.gov.co
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials/service-account.json

# --- SECOP II ---
SECOP_URL=https://community.secop.gov.co/
SECOP_USER=tu_usuario_secop
SECOP_PASSWORD=tu_clave_secop

# --- SIA Observa ---
SIA_URL=https://www.siaobserva.auditoria.gov.co/
SIA_USER=gerson.orozco@cauca.gov.co
SIA_PASSWORD=tu_clave_sia

# --- OpenAI (extracción de datos con IA) ---
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Funcionario firmante ---
FUNCIONARIO_NOMBRE=Nombre del Funcionario Autorizado

# --- Plantillas de certificados ---
PLANTILLA_NATURAL=./templates/plantilla_persona_natural.docx
PLANTILLA_JURIDICA=./templates/plantilla_persona_juridica.docx

# --- Storage ---
STORAGE_PATH=./storage
EXCEL_PATH=./storage/certificados.xlsx

# --- PDF ---
PDF_MAX_SIZE_MB=4
GHOSTSCRIPT_PATH=gs

# --- Reintentos de workers ---
MAX_RETRIES=3
RETRY_DELAY_MS=5000
