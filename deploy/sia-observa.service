#!/bin/bash
# ============================================
# Servicio systemd para SIA Observa
# ============================================
# Instalar:
#   sudo cp deploy/sia-observa.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable sia-observa
#   sudo systemctl start sia-observa
#
# Ver estado:
#   sudo systemctl status sia-observa
#   sudo journalctl -u sia-observa -f

[Unit]
Description=Agente SIA Observa — Automatización de Certificados
Documentation=https://github.com/gobernacion-cauca/sia-observa
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sia-observa
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=120

# Reiniciar si falla
Restart=on-failure
RestartSec=30

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sia-observa

[Install]
WantedBy=multi-user.target
